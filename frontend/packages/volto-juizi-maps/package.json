{
  "name": "volto-juizi-maps",
  "version": "1.0.0-alpha.0",
  "description": "Map block for Volto: pins, totals, shaded regions and contact details on a street map in the site's colours",
  "main": "src/index.ts",
  "license": "MIT",
  "keywords": [
    "volto-addon",
    "volto",
    "plone",
    "react"
  ],
  "author": "Juizi",
  "homepage": "https://github.com/juizi-com/juizi-maps#readme",
  "repository": {
    "type": "git",
    "url": "git@github.com:juizi-com/juizi-maps"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "i18n": "rm -rf build/messages && NODE_ENV=production i18n --addon",
    "dry-release": "release-it --dry-run",
    "release": "release-it",
    "release-major-alpha": "release-it major --preRelease=alpha",
    "release-alpha": "release-it --preRelease=alpha"
  },
  "addons": [],
  "theme": "",
  "dependencies": {
    "maplibre-gl": "5.24.0"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-intl": "^3.12.1",
    "react-redux": "8.1.2",
    "react-router-dom": "^5.2.0",
    "semantic-ui-react": "^2.1.5"
  },
  "devDependencies": {
    "@plone/registry": "workspace:*",
    "@plone/scripts": "workspace:*",
    "@plone/types": "workspace:*",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "release-it": "^19.0.5"
